# Copy to .env for local development (never commit the real .env file).
# On Vercel: set these under Project Settings -> Environment Variables.

NODE_ENV=development

# Flask SECRET_KEY equivalent. Required in production; signs session cookies and CSRF tokens.
SECRET_KEY=change-me-to-a-long-random-string

# Admin login (choose ONE of ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
ADMIN_USERNAME=admin
ADMIN_PASSWORD= 
# ADMIN_PASSWORD_HASH=   # a werkzeug.security.generate_password_hash(...) value, if you have one

# Postgres connection string (replaces the old SQLite aptcampus.db file, which cannot persist on
# Vercel's read-only/ephemeral filesystem). Works with Vercel Postgres, Neon, Supabase, etc.
# DATABASE_URL=postgres://postgres.uvrhqvwvylacccodpbm:YOUR-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

DATABASE_URL="postgresql://postgres:Aakash3114@localhost:5432/postgres"


# Email: Resend HTTPS API (recommended on Vercel - plain SMTP sockets are often blocked there)
RESEND_API_KEY=
RESEND_FROM_EMAIL=APT Structural Campus <onboarding@resend.dev>

# Email: SMTP fallback (used automatically when RESEND_API_KEY is not set)
MAIL_SERVER=smtp.zoho.in
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=info@aptcampus.com
MAIL_PASSWORD=
